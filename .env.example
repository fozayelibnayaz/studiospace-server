# Port the Express server listens on (5000 conflicts with macOS AirPlay Receiver)
PORT=5001

# MongoDB connection string (Atlas or local). Database name: studiospaceDB
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=studiospaceDB

# Secret used to sign the JWT issued by POST /jwt
ACCESS_TOKEN_SECRET=

# Comma-separated list of allowed client origins (credentials: true CORS)
CLIENT_URL=http://localhost:3000,http://localhost:3001

# production | development — controls cookie Secure/SameSite behavior
NODE_ENV=development
